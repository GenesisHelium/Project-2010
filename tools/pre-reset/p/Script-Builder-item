                var setDivId = 'set_' + setId + '_' + assetId;
                var imgId = "waiting" + setDivId;
                $(setDivId).append("<img src='/images/spinners/spinner16x16.gif' id='" + imgId + "'");
                $.ajax(
                {
                    type: "GET",
                    async: true,
                    cache: false,
                    timeout: 50000,
                    url: "/Sets/SetHandler.ashx?rqtype=addtoset&assetId=" + assetId + "&setId=" + setId,
