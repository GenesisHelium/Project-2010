                {
                    type: "GET",
                    async: true,
                    cache: false,
                    timeout: 50000,
                    url: "/Sets/SetHandler.ashx?rqtype=addtoset&assetId=" + assetId + "&setId=" + setId,
                    success: function(data)
                    {
                        if (data !== null)
                        {
                            // Remove that set from the list of available sets
                            $('#' + setDivId).removeClass('SetAddButton');
