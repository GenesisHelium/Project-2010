<style type="text/css" media="screen">
.thethe_image_slider  {
  font-family: Arial;
    font-size: 20px;
    line-height: 22px;
   background-color: #FFFFFF !important;
    border: 1px solid #BBBBBB !important;
    clear: both;
    margin: 0 auto;
    overflow: hidden;
    padding: 2px !important;
    position: relative;
    width: 684px !important;

}

.frame-black .thethe-image-slider-thumbnails {
position: absolute;
bottom: -5px;
display:none;
}
.frame-white .thethe-image-slider-thumbnails {
display:none;
}
.thethe_image_slider:not(#ie) .thethe-backlink {
display:none;
}
.thethe-image-slider-controls .thethe-previous, .thethe-image-slider-controls .thethe-pause, .thethe-image-slider-controls .thethe-next, .thethe-image-slider-controls .thethe-play {
background-image: url(wp-content/uploads/2011/10/sliderButtons_02.png);
width:60px!important;height:60px!important;
}
.thethe-image-slider-controls .thethe-next{
background-position: -60px 0% !important;
}
.thethe-image-slider-controls .thethe-previous {
background-position: 0 0% !important;
}
.thethe-image-slider-controls .thethe-pause {
background-position: -180px 0% !important;
}
.thethe-image-slider-controls .thethe-play {
background-position: -120px 0% !important;
}
.thethe-image-slider-controls .thethe-play:hover {
background-position: -120px 100% !important;
}
.thethe-image-slider-controls .thethe-pause:hover {
background-position: -180px 100% !important;
}
.thethe-image-slider-controls .thethe-next:hover {
background-position: -60px 100% !important;
}
.thethe-image-slider-controls .thethe-previous:hover {
background-position: 0 100% !important;
}
.thethe-image-slider-controls {
height:70px!Important;
}
