<div class="content content_grey"><div class="grey_box_top"><div class="box box_top"></div></div>  <!-- REQUEST FORM -->
<form action="/web/20110102164323/http://roblox.zendesk.com/anonymous_requests" enctype="multipart/form-data" id="ticketform" method="post" name="ticketform"><div style="margin:0;padding:0;display:inline"><input name="authenticity_token" type="hidden" value="SrgXhpq1dkj5yz7UzFrlC+kmpohSNE//DcqKAdluOcQ="/></div>    <h2>
      Submit a request
      <span class="sub"></span>
    </h2>

    <input id="uploads_attribute" name="ticket[uploads]" type="hidden"/>
    <input id="ticket_via_followup_source_id" name="ticket[via_followup_source_id]" type="hidden"/>
    
    <input id="ticket_client" name="ticket[client]" type="hidden" value=""/><script type="text/javascript">
//<![CDATA[
$('ticket_client').value = 'Client: ' + navigator.userAgent;
//]]>
</script>

    <div id="end-user-form" style="width:98%;">
        <h3>Your email address <super>*</super></h3>
          <p>If you are a registered user, please <a href="/web/20110102164323/http://roblox.zendesk.com/login?return_to=http%3A%2F%2Froblox.zendesk.com%2Frequests%2Fnew">login</a> first to submit a request.</p>
        <p><input class="title" id="email_address" name="email" size="30" type="text" value=""/></p>

      <h3>Subject <super>*</super></h3>
<p><input class="title" id="ticket_subject" name="ticket[subject]" size="30" type="text"/></p><h3>Description <super>*</super></h3>
<p>Please enter the details of your request. A member of our support staff will respond as soon as possible.</p><p><textarea cols="68" id="comment_value" name="comment[value]" rows="6" style="width:100%"></textarea></p>
    </div>

      <h3>Please verify that you are human <super>*</super></h3>
<div id="recaptcha_widget">
  <div id="recaptcha_data">
    <div id="recaptcha_image" style="width:300px;height:57px;float:left;background-color:white;padding:10px;border:1px solid #a8a8a8"></div>
  </div>
  <div style="float: left;">
    <ul style="padding-left: 20px;">
      <li><a href="javascript:Recaptcha.reload()">Two other words please</a></li>
      <li><a id="recaptcha_switch_audio_btn" class="recaptcha_only_if_image" href="javascript:Recaptcha.switch_type('audio');" title="Get an audio challenge">I want audio instead</a>
      <a id="recaptcha_switch_img_btn" class="recaptcha_only_if_audio" href="javascript:Recaptcha.switch_type('image');" title="Get a visual challenge">I want an image instead</a></li>
    </ul>
  </div>
  <br style="clear: left;"/>
  <p style="margin-bottom: 0;">Type the above two words in below</p>
  <input type="text" id="recaptcha_response_field" name="recaptcha_response_field" style="width: 310px">
</div>

<script type="text/javascript">
  var RecaptchaOptions = {"theme":"custom"};
</script>
<script type="text/javascript" src="https://web.archive.org/web/20110102164323js_/https://api-secure.recaptcha.net/challenge?k=6LdqCAYAAAAAACOM-OJC2ruG0sNZYvulQLA0UBSe&amp;error=expression"></script>
<noscript>
  <iframe src="https://web.archive.org/web/20110102164323if_/https://api-secure.recaptcha.net/noscript?k=6LdqCAYAAAAAACOM-OJC2ruG0sNZYvulQLA0UBSe" height="300" width="500" frameborder="0"></iframe><br/>
  <textarea name="recaptcha_challenge_field" rows="3" cols="40"></textarea>
  <input type="hidden" name="recaptcha_response_field" value="manual_challenge"></noscript>


</form>
    <h3>Attachment(s)</h3>
    <!-- ATTACHMENTS FORM -->
    

<script type="text/javascript">
  function checkMaxUploads() {
    if ( $$('div.attach_item').size() >= 10 ) {
      alert('You can attach only 10 files');
      document.attach_form.reset();
    } else {
      submitAttachForm("Uploading...");
    }
  }
  function checkUploadError() {
    var iFrame = $('upload_frame');
    var iFrameBody;
    if ( iFrame.contentDocument ) { // FF
      iFrameBody = iFrame.contentDocument.getElementsByTagName('body')[0];
    }
    else if ( iFrame.contentWindow ) { // IE
      iFrameBody = iFrame.contentWindow.document.getElementsByTagName('body')[0];
    }
    if (iFrameBody.innerHTML.include('Something went wrong')) {
      $('submit-button').value = 'Submit';
$('submit-button').disabled = false;
$('uploading_message').addClassName('display_none');
$('uploads_form').show();
      alert("There was an error with the attachment. Please try again or contact our support team if the problem continues.");
    }
  }
</script>

<div id="uploads_form">
  <!-- Attach Files Link -->
  <a class="attach_files" href="#" id="uploads_link" onclick="toggleAttachForm(); return false;">Attach file(s) &raquo;</a>

  <!-- Attach Form -->
  <div id="uploads_field" class="attach_form unfolded">
<form action="/web/20110102164323/http://roblox.zendesk.com/fileuploads?format=js" enctype="multipart/form-data" id="attach_form" method="post" name="attach_form" target="upload_frame"><div style="margin:0;padding:0;display:inline"><input name="authenticity_token" type="hidden" value="SrgXhpq1dkj5yz7UzFrlC+kmpohSNE//DcqKAdluOcQ="/></div>      <div class="close_attachments">(<a href="#" onclick="toggleAttachForm(); return false;">Close</a>)</div>
      <input id="uploaded_data" name="uploaded_data" onchange="checkMaxUploads();toggleAttachForm();" type="file"/>      <input id="token" name="token" type="hidden"/>
      <div class="note">
        Max file size: 7MB
      </div>
</form>
    <!-- Target iFrame -->
    <iframe id="upload_frame" name="upload_frame" src="about:blank" onload="checkUploadError();"></iframe>
  </div>
</div>

<!-- Uploading Message -->
<div id="uploading_message" class="uploading_message display_none">
  <img id="uploading_indicator" src="/web/20110102164323im_/http://roblox.zendesk.com/images/indicator2.gif"/>
  Uploading...
</div>

    <!-- ATTACHMENTS LIST -->
    <div id="attachments" class="attach_list clearfix">
</div>

  <!-- ACTIONS FORM -->
<form action="/web/20110102164323/http://roblox.zendesk.com/anonymous_requests/new" id="submit_form" method="post"><div style="margin:0;padding:0;display:inline"><input name="authenticity_token" type="hidden" value="SrgXhpq1dkj5yz7UzFrlC+kmpohSNE//DcqKAdluOcQ="/></div>    <div class="action">
      <input class="buttonsubmit" id="submit-button" name="commit" onclick="submitRequestForm()" type="button" value="Submit"/>
    </div>
</form><div class="grey_box_bottom"><div class="box box_bottom"></div></div></div><div class="box_bottom_clear">&nbsp;</div>
    </div>
