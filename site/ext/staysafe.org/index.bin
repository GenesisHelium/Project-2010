                        <hr id='FeedbackRule'><table id='Feedback_table' class='FeedbackTable'><tr><td><div class='FeedbackHeading'>Was This Information Useful?</div></td></tr><tr><td><input class='FeedbackButtonStyle' type='button' id='Yes1' value='Yes' title='Yes' onclick="fnOptionClicked('/business/feedback/frmsurveyform.aspx','1','b157835d-fb0e-4b9d-8cc1-172d5bbbae8e')"><input class='FeedbackButtonStyle' type='button' id='No2' value='No' title='No' onclick="fnOptionClicked('/business/feedback/frmsurveyform.aspx','2','b157835d-fb0e-4b9d-8cc1-172d5bbbae8e')"></td></tr></table>

<script type="text/javascript" language="javascript">
    var objNewWin;
    var str_FEEDBACK_VALUE;
    var str_UNIQUE_SESSION_ID;
    
    function fnOptionClicked(strLinkUrl,strSurveyValue,strSessionGUID)
    {
        var strResult;
        var strTitle;
        var strXMLText;
        var strUrl;
        var strDescription;
        var strContentTopic;
        var strContentType;
        
        // supply domain name to allow Cross-Frame Scripting and Security 
        //document.domain="wwwppe"; //for example domain name will be 'microsoft.com'
           //alert(strLinkUrl); 
        if(strLinkUrl != '')
        {   
	        
	        strTitle=document.title;
	        strUrl=window.location.href;
	        
	        strDescription=fnGetArticleMetaValue("description");        //reading description
	        strContentTopic=fnGetArticleMetaValue("contentTopic");      //reading content topic
	        strContentType=fnGetArticleMetaValue("contentType");        //reading content type 
	        
	        strContentType=fnDecode(strContentType);                    //decoding to avoid error from asp.net while data transfer
	        strContentTopic=fnDecode(strContentTopic);                  //decoding to avoid error from asp.net while data transfer
	        strDescription=fnDecode(strDescription);                    //decoding to avoid error from asp.net while data transfer
	        strTitle=fnDecode(strTitle);
	        //alert(strTitle);
	        //generating xml data for data transfer to survey form and storing in variable
            str_FEEDBACK_VALUE="&lt;POSTEDDATA&gt;&lt;URL Value='" + strUrl + "'/&gt;&lt;TITLE Value='" + strTitle + "'/&gt;&lt;USERRESPONSE Value='" + strSurveyValue + "'/&gt;&lt;CONTENTTOPIC Value='" + strContentTopic + "'/&gt;&lt;CONTENTTYPE Value='" + strContentType + "'/&gt;&lt;DESCRIPTION Value='" + strDescription + "'/&gt;&lt;/POSTEDDATA&gt;";
            //alert(str_FEEDBACK_VALUE);
    	    //storing session id in variable for data transfer
    	    str_UNIQUE_SESSION_ID=strSessionGUID; 
    	    
	        try
	        {
	            objNewWin.close(); //to close survey form if already open
	        }
	        catch(e)
	        {
	            //do nothing
	        }
	                
	        //openning survey form in new window
	        objNewWin=window.open(strLinkUrl,"displayWindow","scrollbars=yes,width=650,height=415,left=" + (screen.width - 650) / 2  +  ",top=" +   (screen.height - 366) / 2);
	                
	    }

    }
    
    //function to decode text
    function fnDecode(strText)
    {
        strText=strText.replace("'","&quot;");
        strText=strText.replace("<","&lt;");
        strText = strText.replace(">", "&gt;");
        //strText = strText.replace("&", "&amp;");
        strText=strText.replace("&#","_#^#_"); //encoding the &# to handle extended asci characters, will be decoded back in the survey form
        return strText;
    }
    
    
    //function to read meta data
    function fnGetArticleMetaValue(strAttributeName)
    {   
        var objXMLDOMNodeList = document.getElementsByTagName("meta"); //get nodelist of meta tags
        if(objXMLDOMNodeList!=null)
        {
            for(var intCount=0;intCount<objXMLDOMNodeList.length;intCount++) //looping in nodelist
            {
                if(objXMLDOMNodeList[intCount].getAttribute("name") != null){
                    if (objXMLDOMNodeList[intCount].getAttribute("name").toUpperCase() == strAttributeName.toUpperCase()) //comparing attribute of node element
                    {
                        return objXMLDOMNodeList[intCount].getAttribute("content"); //returning the meta data value
                    }
                }
            }
        }
        return ""; //returning blank in case meta data not found
    }

</script>


