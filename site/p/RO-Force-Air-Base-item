        $(document).ready(function()
        {
            $('.SetAddButton').click(function()
            {
                var assetId = $(this).parent().parent().attr('id').replace('setList_', '');
                var setId = $(this).children('.setId')[0].value;
                var setDivId = 'set_' + setId + '_' + assetId;
