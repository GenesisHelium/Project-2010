                function toggleAssetDetails() {
                    if ($("#ToggleDetails").text() == "Hide Item Details") {
                        $("#ToggleDetails").text("Show Item Details");
                        $(".AssetDetails").slideUp("slow");
                        $("#ctl00_cphRoblox_rbxCatalog_FooterPagerLabel").removeClass("HeaderPager");
                        $("#ctl00_cphRoblox_rbxCatalog_FooterPagerLabel").addClass("HeaderPager");
                        createCookieCatalog("catdet", "hidden", 30)
                    }
                    else {
                        $("#ToggleDetails").text("Hide Item Details");
                        $(".AssetDetails").slideDown("slow");
                        createCookieCatalog("catdet", "default", 30)
                    }
                }
                
                $(document).ready(function() {
                    if (checkCookieCatalog("catdet") != "") {
                        var catdetview = checkCookieCatalog("catdet");
                        if (catdetview == "hidden") {
                            $("#ToggleDetails").text("Show Item Details");
                            $(".AssetDetails").css("display", "none");
                            $("#ctl00_cphRoblox_rbxCatalog_FooterPagerLabel").removeClass("HeaderPager");
                            $("#ctl00_cphRoblox_rbxCatalog_FooterPagerLabel").addClass("HeaderPager");
                        }
                        else {
                            $("#ToggleDetails").text("Hide Item Details");
                        }
                    }
                    if (checkCookieCatalog("catcol") != "") {
                        var catcolview = checkCookieCatalog("catcol");
                        if (catcolview == "dark") {
                            $("#ToggleColors").text("Light Background");
                            $(".AssetThumbnail").css("background-color", "#000000");
                        }
                        else {
                            $("#ToggleColors").text("Dark Background");
                        }
                    }
                });
                
                function createCookieCatalog(name, value, expires) {
                    var date = new Date();
                    date.setDate(date.getDate() + expires);
                    document.cookie = name + "=" + value + ((expires == null) ? "" : ";expires=" + date.toGMTString());
                }

                function checkCookieCatalog(name) {
                    if (document.cookie.length > 0) {
                        var start = document.cookie.indexOf(name + "=");
                        if (start != -1) {
                            start = start + name.length + 1;
                            var end = document.cookie.indexOf(";", start);
                            if (end == -1) {
                                end = document.cookie.length;
                            }
                            return document.cookie.substring(start, end);
                        }
                    }
                    else {
                        return "";
                    }
                }

                function deleteCookieCatalog(name) {
                    if (checkCookie(name) != "") {
                        createCookie(name, "false", -10);
                    }
                }
            </script>

