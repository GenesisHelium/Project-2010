<script type="text/javascript">
    function selectPayment(provider) {
        if (provider == "wallie") {
            $("#wallieProducts").show();
            $("#rixty").css("visibility", "hidden");
            $("#boku").css("visibility", "hidden");
        } else if (provider == "rixty") {
            window.location = "/rixty";
            return;
        } else if (provider == "boku") {
            $("#bokuProducts").show();
            $("#rixty").css("visibility", "hidden");
            $("#wallie").css("visibility", "hidden");
        }
        $("#amountBox").slideDown();
        $("input:hidden[id $= 'paymentprovider']").val(provider);
    }
    function validateAmount() {
        var provider = $("input:hidden[id $= 'paymentprovider']").val();
        if (provider == "wallie" && $("select[id $= 'lstWallieProducts'] :selected").val() == "") {
            $("#validationError").show();
            return false;
        }
        if (provider == "boku" && $("select[id $= 'lstBokuProducts'] :selected").val() == "") {
            $("#validationError").show();
            return false;
        }
        $("#validationError").hide();
        return true;
    }
</script>
