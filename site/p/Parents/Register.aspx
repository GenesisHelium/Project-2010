    <script language="javascript">
        function ClientValidate(source, arguments) {
            var username = $get('ctl00_cphRoblox_AccountNameTextBox').value;
            var onSuccess = function (result, context) {
                if (result != username) {
                    $get('ctl00_cphRoblox_AccountNameAlreadyTaken').style.display = "inline";
                    $get('ctl00_cphRoblox_SuggestedAccountName').innerHTML = "Try " + result + " instead!";
                    $get('ctl00_cphRoblox_SuggestedAccountName').style.display = "inline";

                }
                else {
                    $get('ctl00_cphRoblox_AccountNameAlreadyTaken').style.display = "none";
                    $get('ctl00_cphRoblox_SuggestedAccountName').innerHTML = "";
                    $get('ctl00_cphRoblox_SuggestedAccountName').style.display = "none";
                }
            };
            var onError = function (result, context) { };
            UserCheck.GetRecommendedUsername(username, onSuccess, onError, this);

        }

    </script>

